# ==============================================================================
# RAG Copilot Configuration
# Copy this file to .env and adjust values as needed:
#   cp .env.example .env
# ==============================================================================

# LLM Configuration (supports Ollama, Groq, OpenAI, Together, vLLM, etc.)
# For local Ollama:
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=llama3

# For Groq (ultra fast cloud inference):
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=gsk_your_groq_api_key_here
# LLM_MODEL=llama-3.1-8b-instant

# For OpenAI:
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-proj-your_openai_api_key_here
# LLM_MODEL=gpt-4o-mini

# API Authentication (Required for POST /query, /ingest, etc.)
API_KEY=super-secret-token

# Retrieval settings
RETRIEVAL_TOP_K=5
RERANK_TOP_K=5
RETRIEVE_K=10

# Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
